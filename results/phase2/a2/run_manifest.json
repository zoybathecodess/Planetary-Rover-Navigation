      "sha256": "b4cf358e0fdfc7208b26612f29a8ab99bcffaf588c0666c176c7cc9e0c78d4e3",
      "text": "# DEFAULT reference config: leak-free 15-d onboard observation, no privileged reward shaping.\nenv: {size: 10, battery: 100, obs_mode: onboard, reward_privileged_shaping: false}\nrun: {seed: 0, episodes: 1500, out_dir: results/ref_onboard}\n"
    },
    "configs/baseline_10x10_onboard_ppofix.yaml": {
      "sha256": "c358ebafdc6948dbca162b758f574758c33340d32f322286c52d55c28149ea5f",
      "text": "env:\n  battery: 100\n  obs_mode: onboard\n  reward_privileged_shaping: false\n  size: 10\nppo:\n  entropy_coef: 0.003\n  reward_scale: 0.02\nrun:\n  episodes: 1500\n  out_dir: results/ppofix_onboard\n  seed: 0\n"
    },
    "configs/baseline_10x10_onboard_shaped.yaml": {
      "sha256": "c008b356f129dbf7e64d03f7f43f32742ff30a0d6484a53e459abe9d74efc851",
      "text": "# Leak-free observation, but keeps the original per-step budget-margin reward shaping\n# (uses full-map Dijkstra in the REWARD only; policy never sees it). Use to test whether\n# shaping is needed to reproduce original learning quality.\nenv: {size: 10, battery: 100, obs_mode: onboard, reward_privileged_shaping: true}\nrun: {seed: 0, episodes: 1500, out_dir: results/ref_onboard_shaped}\n"
    },
    "configs/legacy17_reproduction.yaml": {
      "sha256": "d312bb1425cca0f51b5aa73ae18adf4e284ee311e5cbe81bc6eab9bf89b1b334",
      "text": "# Original 17-d observation INCLUDING privileged features. Reproduction/ablation only.\n# Never use for any result that is presented as partially observable.\nenv: {size: 10, battery: 100, obs_mode: legacy17, reward_privileged_shaping: true}\nrun: {seed: 0, episodes: 1500, log_margin: true, out_dir: results/ref_legacy17}\n"
    },
    "configs/sim32_combined_shift.yaml": {
      "sha256": "6908907ac558e4af7e4a99977033b7c6c413ba64f7bada4a51af0098ef8e88f3",
      "text": "# Task 2 preset: terrain + sensor + dynamics shifts together.\n# TRUE simulator parameters; the rover never sees them (see docs/OBSERVATION_SCHEMA_V2.md).\nenv:\n  kind: advanced\n  size: 32\n  battery: 250\n  p_normal: 0.35\n  p_sand: 0.25\n  p_rock: 0.22\n  gen_corr: 3\n  energy_cost: [1, 4, 6]\n  slip_prob: [0.06, 0.25, 0.15]\n  sensor_miss: 0.2\n  sensor_false: 0.08\n  sensor_sigma: 0.15\nrun: {seed: 0, episodes: 1500, out_dir: results/sim32_combined_shift}\n"
    },
    "configs/sim32_dynamics_shift.yaml": {
      "sha256": "2a70619ea7af9be3ecd0dd1709766c722ea44c806dfed69623d4d177c46541c3",
      "text": "# Task 2 preset: dynamics shift: costlier sand/rock, 2.5-3x slip.\n# TRUE simulator parameters; the rover never sees them (see docs/OBSERVATION_SCHEMA_V2.md).\nenv:\n  kind: advanced\n  size: 32\n  battery: 250\n  p_normal: 0.6\n  p_sand: 0.15\n  p_rock: 0.1\n  gen_corr: 2\n  energy_cost: [1, 4, 6]\n  slip_prob: [0.06, 0.25, 0.15]\n  sensor_miss: 0.05\n  sensor_false: 0.02\n  sensor_sigma: 0.05\nrun: {seed: 0, episodes: 1500, out_dir: results/sim32_dynamics_shift}\n"
    },
    "configs/sim32_id.yaml": {
      "sha256": "35f91b43b11dec8e9f551ebbd9f432689a35009b84397b508102bcf50a660fb9",
      "text": "# Task 2 preset: in-distribution (training distribution).\n# TRUE simulator parameters; the rover never sees them (see docs/OBSERVATION_SCHEMA_V2.md).\nenv:\n  kind: advanced\n  size: 32\n  battery: 250\n  p_normal: 0.6\n  p_sand: 0.15\n  p_rock: 0.1\n  gen_corr: 2\n  energy_cost: [1, 3, 5]\n  slip_prob: [0.02, 0.1, 0.05]\n  sensor_miss: 0.05\n  sensor_false: 0.02\n  sensor_sigma: 0.05\nrun: {seed: 0, episodes: 1500, out_dir: results/sim32_id}\n"
    },
    "configs/sim32_id_ensemble.yaml": {
      "sha256": "d2d845b70f990d8d3dfb4dc0c4190ffde849a6571dd7a57a7f3746d16052f6ad",
      "text": "# Task 4: in-distribution env + ensemble-member settings (randomized prior + Poisson bootstrap) + assurance defaults.\nenv:\n  kind: advanced\n  size: 32\n  battery: 250\n  p_normal: 0.6\n  p_sand: 0.15\n  p_rock: 0.1\n  gen_corr: 2\n  energy_cost: [1, 3, 5]\n  slip_prob: [0.02, 0.1, 0.05]\n  sensor_miss: 0.05\n  sensor_false: 0.02\n  sensor_sigma: 0.05\ndqn:\n  prior_scale: 10.0\n  prior_hidden: [64, 64]\n  bootstrap: true\nassurance: {n_members: 5, unc_percentile: 95.0, ood_percentile: 99.0}\nrun: {seed: 0, episodes: 1500, out_dir: results/sim32_id_ensemble}\n"
    },
    "configs/sim32_id_ppo.yaml": {
      "sha256": "a54c1166ef2b9d688b34072f444f8bd24a426a95aa34cea21a3b35e9d69282fd",
      "text": "# Task 3: in-distribution env + the PPO settings from the Task-1 fix, carried over UNCHANGED (not retuned for 32x32).\n# A 1-seed probe on validation maps showed entropy_coef in {0.01, 0.003, 0.0} all end at 0.92-0.93, i.e. indistinguishable.\nenv:\n  kind: advanced\n  size: 32\n  battery: 250\n  p_normal: 0.6\n  p_sand: 0.15\n  p_rock: 0.1\n  gen_corr: 2\n  energy_cost: [1, 3, 5]\n  slip_prob: [0.02, 0.1, 0.05]\n  sensor_miss: 0.05\n  sensor_false: 0.02\n  sensor_sigma: 0.05\nppo: {reward_scale: 0.02, entropy_coef: 0.003}\nrun: {seed: 0, episodes: 1500, out_dir: results/sim32_id_ppo}\n"
    },
    "configs/sim32_real_hirise.yaml": {
      "sha256": "c1b1443102089b961ae31679f39093b76bf23050f092c29db75e86931c1ba4bd",
      "text": "# Amendment A2: in-distribution physics (sensor, slip, energy = configs/sim32_id.yaml) on real-terrain tiles from HiRISE DTMs.\n# Terrain probabilities below are unused (tiles are loaded by seed from external_tiles).\nenv:\n  kind: advanced\n  size: 32\n  battery: 250\n  p_normal: 0.6\n  p_sand: 0.15\n  p_rock: 0.1\n  gen_corr: 2\n  energy_cost: [1, 3, 5]\n  slip_prob: [0.02, 0.1, 0.05]\n  sensor_miss: 0.05\n  sensor_false: 0.02\n  sensor_sigma: 0.05\n  external_tiles: data/real_tiles/hirise_tiles.npz\nrun: {seed: 0}\n"
    },
    "configs/sim32_sensor_shift.yaml": {
      "sha256": "e97a7a44af33c789acc171b9cc633988fd95a9e892d8af792df49868bd386dae",
      "text": "# Task 2 preset: sensor shift: 4x miss rate, 4x false-detection rate, 3x reading noise.\n# TRUE simulator parameters; the rover never sees them (see docs/OBSERVATION_SCHEMA_V2.md).\nenv:\n  kind: advanced\n  size: 32\n  battery: 250\n  p_normal: 0.6\n  p_sand: 0.15\n  p_rock: 0.1\n  gen_corr: 2\n  energy_cost: [1, 3, 5]\n  slip_prob: [0.02, 0.1, 0.05]\n  sensor_miss: 0.2\n  sensor_false: 0.08\n  sensor_sigma: 0.15\nrun: {seed: 0, episodes: 1500, out_dir: results/sim32_sensor_shift}\n"
    },
